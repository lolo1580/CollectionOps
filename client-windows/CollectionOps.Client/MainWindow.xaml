<Window
    x:Class="CollectionOps.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CollectionOps.Client.Views"
    Title="CollectionOps">

    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Auto"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Accueil" Tag="dashboard">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Inventaire" Tag="inventory">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Acquisitions" Tag="acquisitions">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Shop" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Documents" Tag="documents" />
            <NavigationViewItem Content="Finances" Tag="finance" />
            <NavigationViewItem Content="Organisation" Tag="organization">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Partage" Tag="sharing">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="People" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Compte" Tag="account">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame">
            <views:DashboardPage />
        </Frame>
    </NavigationView>
</Window>

