<Page
    x:Class="CollectionOps.Client.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:CollectionOps.Client.Services">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Compte et connexion" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Connectez ce client au serveur CollectionOps pour gérer vos sessions." TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <TextBlock Text="Serveur" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="ServerAddress" Header="Adresse du serveur" Text="http://127.0.0.1:8080" PlaceholderText="https://collectionops.exemple.org" />
            <Button x:Name="CheckServerButton" Content="Tester la connexion" Click="OnCheckServer" />
            <TextBlock Text="HTTPS est obligatoire à distance. Pour un serveur HTTP sur le LAN de développement, activez d'abord l'option dans Paramètres." TextWrapping="Wrap" Opacity="0.7" />

            <TextBlock Text="Connexion" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBox x:Name="EmailAddress" Header="Adresse e-mail" InputScope="EmailSmtpAddress" />
            <PasswordBox x:Name="Password" Header="Mot de passe" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SignInButton" Content="Se connecter" Click="OnSignIn" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="SignOutButton" Content="Se déconnecter de ce client" Click="OnSignOut" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="La session de ce client n'est pas enregistrée sur le disque. Le serveur applique un délai d'inactivité de 30 minutes." TextWrapping="Wrap" Opacity="0.7" />

            <TextBlock Text="Accepter une invitation" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="Collez le lien reçu par e-mail. Si vous possédez déjà un compte, connectez-vous d'abord avec l'adresse invitée. Sinon, renseignez un nom et un mot de passe pour créer votre compte." TextWrapping="Wrap" />
            <TextBox x:Name="InvitationLink" Header="Lien d'invitation" PlaceholderText="collectionops://invite/..." />
            <TextBox x:Name="InvitedName" Header="Nom affiché (nouveau compte uniquement)" />
            <PasswordBox x:Name="InvitedPassword" Header="Mot de passe (nouveau compte uniquement)" />
            <Button x:Name="AcceptInvitationButton" Content="Accepter l'invitation" Click="OnAcceptInvitation" Style="{StaticResource AccentButtonStyle}" />

            <TextBlock Text="Appareils connectés" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <Button x:Name="RefreshButton" Content="Actualiser les sessions" Click="OnRefresh" IsEnabled="False" />
            <ListView x:Name="SessionsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:SessionSummary">
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,8">
                            <StackPanel Width="380">
                                <TextBlock Text="{x:Bind DeviceLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Id}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Content="Révoquer" Tag="{x:Bind Id}" Click="OnRevoke" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
