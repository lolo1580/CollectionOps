<Page
    x:Class="CollectionOps.Client.Views.CollectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:CollectionOps.Client.Services">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Collection" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Choisissez un espace pour consulter son inventaire. Connectez-vous d'abord dans Compte." TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <TextBlock Text="Mes espaces" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshSpacesButton" Content="Actualiser" Click="OnRefreshSpaces" />
                <TextBox x:Name="NewSpaceName" PlaceholderText="Nom du nouvel espace" Width="280" />
                <Button x:Name="CreateSpaceButton" Content="Créer un espace" Click="OnCreateSpace" />
            </StackPanel>
            <ComboBox x:Name="Spaces" Header="Espace actif" Width="400" HorizontalAlignment="Left"
                      DisplayMemberPath="Name" SelectionChanged="OnSpaceSelected" />

            <TextBlock Text="Inventaire" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewItemName" PlaceholderText="Nom du nouvel objet" Width="280" />
                <Button x:Name="CreateItemButton" Content="Ajouter à l'inventaire" Click="OnCreateItem" />
                <Button x:Name="RefreshItemsButton" Content="Actualiser" Click="OnRefreshItems" />
            </StackPanel>
            <ListView x:Name="Items" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:InventoryItem">
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,8">
                            <TextBlock Text="{x:Bind InventoryNumber}" Width="80" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Name}" Width="440" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
