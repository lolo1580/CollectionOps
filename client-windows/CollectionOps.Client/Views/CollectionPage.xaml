<Page
    x:Class="CollectionOps.Client.Views.CollectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:CollectionOps.Client.Services">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Collection" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Choisissez un espace pour consulter son inventaire. Connectez-vous d'abord dans Compte." TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <TextBlock Text="Mes espaces" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshSpacesButton" Content="Actualiser" Click="OnRefreshSpaces" />
                <TextBox x:Name="NewSpaceName" PlaceholderText="Nom du nouvel espace" Width="280" />
                <Button x:Name="CreateSpaceButton" Content="Créer un espace" Click="OnCreateSpace" />
            </StackPanel>
            <ComboBox x:Name="Spaces" Header="Espace actif" Width="400" HorizontalAlignment="Left"
                      DisplayMemberPath="Name" SelectionChanged="OnSpaceSelected" />

            <TextBlock Text="Catégories et champs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="Les catégories peuvent être imbriquées. Un champ défini sur une catégorie parente est hérité par ses sous-catégories." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewCategoryName" PlaceholderText="Nom de la catégorie" Width="250" />
                <ComboBox x:Name="ParentCategories" Header="Parent" Width="270" DisplayMemberPath="Label" />
                <Button x:Name="CreateCategoryButton" Content="Créer" Click="OnCreateCategory" VerticalAlignment="Bottom" />
            </StackPanel>
            <ComboBox x:Name="ManageCategories" Header="Catégorie à gérer" Width="400"
                      DisplayMemberPath="Label" SelectionChanged="OnManageCategorySelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="EditedCategoryName" Header="Nouveau nom de la catégorie" Width="300" MaxLength="255" />
                <Button x:Name="RenameCategoryButton" Content="Renommer la catégorie" Click="OnRenameCategory" VerticalAlignment="Bottom" />
            </StackPanel>
            <ComboBox x:Name="FieldCategory" Header="Catégorie pour définir un champ" Width="400"
                      DisplayMemberPath="Label" SelectionChanged="OnFieldCategorySelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewFieldName" PlaceholderText="Nom du champ" Width="240" />
                <ComboBox x:Name="NewFieldType" Header="Type" Width="140" SelectedIndex="0">
                    <ComboBoxItem Content="Texte" Tag="text" />
                    <ComboBoxItem Content="Nombre" Tag="number" />
                    <ComboBoxItem Content="Date" Tag="date" />
                </ComboBox>
                <Button x:Name="CreateFieldButton" Content="Créer le champ" Click="OnCreateField" VerticalAlignment="Bottom" />
            </StackPanel>
            <ListView x:Name="CategoryFields" SelectionMode="Single" Height="100" DisplayMemberPath="Label" SelectionChanged="OnCategoryFieldSelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="EditedFieldName" Header="Nouveau nom du champ" Width="300" MaxLength="255" />
                <Button x:Name="RenameFieldButton" Content="Renommer le champ" Click="OnRenameCategoryField" VerticalAlignment="Bottom" />
            </StackPanel>

            <TextBlock Text="Emplacements physiques" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="Organisez les pièces, meubles et étagères dans une hiérarchie propre à cet espace." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewLocationName" PlaceholderText="Nom de l'emplacement" Width="250" />
                <ComboBox x:Name="ParentLocations" Header="Parent" Width="270" DisplayMemberPath="Label" />
                <Button x:Name="CreateLocationButton" Content="Créer" Click="OnCreateLocation" VerticalAlignment="Bottom" />
            </StackPanel>

            <TextBlock Text="Séries et regroupements" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="Créez des séries ou des ensembles propres à cet espace ; un objet peut appartenir à plusieurs d'entre eux." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewGroupName" PlaceholderText="Nom" Width="260" />
                <ComboBox x:Name="NewGroupKind" Header="Type" Width="170" SelectedIndex="0">
                    <ComboBoxItem Content="Série" Tag="series" />
                    <ComboBoxItem Content="Regroupement" Tag="group" />
                </ComboBox>
                <Button x:Name="CreateGroupButton" Content="Créer" Click="OnCreateGroup" VerticalAlignment="Bottom" />
            </StackPanel>
            <ComboBox x:Name="ManageGroups" Header="Série ou regroupement à gérer" Width="400"
                      DisplayMemberPath="Label" SelectionChanged="OnManageGroupSelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="EditedGroupName" Header="Nouveau nom" Width="300" MaxLength="255" />
                <Button x:Name="RenameGroupButton" Content="Renommer" Click="OnRenameGroup" VerticalAlignment="Bottom" />
                <Button x:Name="DeleteGroupButton" Content="Supprimer si vide" Click="OnDeleteGroup" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel x:Name="SharingPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Partager cet espace" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBlock Text="Seul le propriétaire peut inviter. La lecture de la collection est présélectionnée ; aucun droit financier n'est accordé par défaut. Un nouvel envoi à la même adresse invalide le précédent lien." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="GrantCollectionsRead" Content="Collection · lire" IsChecked="True" />
                    <CheckBox x:Name="GrantCollectionsWrite" Content="Collection · écrire" />
                    <CheckBox x:Name="GrantAcquisitionsRead" Content="Acquisitions · lire" />
                    <CheckBox x:Name="GrantAcquisitionsWrite" Content="Acquisitions · écrire" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="GrantFinanceRead" Content="Finances · lire" />
                    <CheckBox x:Name="GrantFinanceWrite" Content="Finances · écrire" />
                    <CheckBox x:Name="GrantDocumentsRead" Content="Documents · lire" />
                    <CheckBox x:Name="GrantDocumentsWrite" Content="Documents · écrire" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="InviteEmail" PlaceholderText="Adresse e-mail" Width="320" />
                    <Button x:Name="InviteButton" Content="Envoyer l'invitation" Click="OnInvite" />
                    <Button x:Name="RefreshInvitationsButton" Content="Actualiser" Click="OnRefreshInvitations" />
                </StackPanel>
                <ListView x:Name="Invitations" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:SpaceInvitation">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,6">
                                <TextBlock Text="{x:Bind RecipientEmail}" Width="280" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Status}" Width="90" />
                                <TextBlock Text="{x:Bind PermissionsSummary}" Width="260" TextTrimming="CharacterEllipsis" />
                                <Button Content="Révoquer" Tag="{x:Bind Id}" IsEnabled="{x:Bind IsPending}" Click="OnRevokeInvitation" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel x:Name="MembersPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Membres et droits" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBlock Text="Le propriétaire ou un administrateur système peut modifier les droits d'un autre membre, y compris les finances, ou le retirer. Ces actions sont auditées." TextWrapping="Wrap" />
                <ComboBox x:Name="Members" Header="Membre" Width="400" HorizontalAlignment="Left"
                          DisplayMemberPath="Label" SelectionChanged="OnMemberSelected" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="MemberCollectionsRead" Content="Collection · lire" />
                    <CheckBox x:Name="MemberCollectionsWrite" Content="Collection · écrire" />
                    <CheckBox x:Name="MemberAcquisitionsRead" Content="Acquisitions · lire" />
                    <CheckBox x:Name="MemberAcquisitionsWrite" Content="Acquisitions · écrire" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="MemberFinanceRead" Content="Finances · lire" />
                    <CheckBox x:Name="MemberFinanceWrite" Content="Finances · écrire" />
                    <CheckBox x:Name="MemberDocumentsRead" Content="Documents · lire" />
                    <CheckBox x:Name="MemberDocumentsWrite" Content="Documents · écrire" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveMemberRightsButton" Content="Enregistrer les droits" Click="OnSaveMemberRights" />
                    <Button x:Name="RemoveMemberButton" Content="Retirer ce membre" Click="OnRemoveMember" />
                    <Button x:Name="RefreshMembersButton" Content="Actualiser" Click="OnRefreshMembers" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="AcquisitionsPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Acquisitions · recherches et offres" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBlock Text="Cette première tranche ne contient aucun prix ni montant financier." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewWishTitle" Header="Objet recherché" Width="300" MaxLength="255" />
                    <TextBox x:Name="NewWishNotes" Header="Notes de recherche" Width="350" MaxLength="10000" />
                    <Button x:Name="CreateWishButton" Content="Ajouter l'envie" Click="OnCreateWish" VerticalAlignment="Bottom" />
                </StackPanel>
                <ListView x:Name="Wishes" Height="130" DisplayMemberPath="Title" SelectionChanged="OnWishSelected" />
                <TextBlock x:Name="SelectedWishNotes" Text="Choisissez une envie pour voir ses offres." TextWrapping="Wrap" />
                <TextBlock Text="Fournisseurs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewVendorName" Header="Nom" Width="260" MaxLength="255" />
                    <TextBox x:Name="NewVendorWebsite" Header="Site web (facultatif)" Width="350" MaxLength="2048" />
                    <Button x:Name="CreateVendorButton" Content="Ajouter le fournisseur" Click="OnCreateVendor" VerticalAlignment="Bottom" />
                </StackPanel>
                <ListView x:Name="Vendors" Height="100" DisplayMemberPath="Label" SelectionMode="None" />
                <TextBlock Text="Offres de l'envie sélectionnée" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewOfferTitle" Header="Titre de l'offre" Width="280" MaxLength="255" />
                    <ComboBox x:Name="OfferVendorChoices" Header="Fournisseur" Width="280" DisplayMemberPath="Name" SelectionChanged="OnOfferVendorSelected" />
                    <Button x:Name="CreateOfferButton" Content="Ajouter l'offre" Click="OnCreateOffer" VerticalAlignment="Bottom" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewOfferUrl" Header="Lien de l'offre (facultatif)" Width="360" MaxLength="2048" />
                    <TextBox x:Name="NewOfferNotes" Header="Notes (facultatif)" Width="360" MaxLength="10000" />
                </StackPanel>
                <ListView x:Name="WishOffers" Height="150" DisplayMemberPath="Label" SelectionMode="None" />
            </StackPanel>

            <TextBlock Text="Inventaire" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="NewItemName" PlaceholderText="Nom du nouvel objet" Width="280" />
                <Button x:Name="CreateItemButton" Content="Ajouter à l'inventaire" Click="OnCreateItem" />
                <Button x:Name="RefreshItemsButton" Content="Actualiser" Click="OnRefreshItems" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="SearchText" PlaceholderText="Rechercher dans le nom" Width="280" />
                <Button x:Name="SearchButton" Content="Rechercher" Click="OnSearch" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="StateFilter" Header="État" Width="180" SelectionChanged="OnStateFilterChanged">
                    <ComboBoxItem Content="Actifs" Tag="active" IsSelected="True" />
                    <ComboBoxItem Content="Archivés" Tag="archived" />
                    <ComboBoxItem Content="Corbeille" Tag="trashed" />
                    <ComboBoxItem Content="Tous" Tag="all" />
                </ComboBox>
                <ComboBox x:Name="CategoryFilter" Header="Catégorie" Width="260"
                          DisplayMemberPath="Label" SelectionChanged="OnCategoryFilterChanged" />
                <ComboBox x:Name="LocationFilter" Header="Emplacement" Width="260"
                          DisplayMemberPath="Label" SelectionChanged="OnLocationFilterChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="GroupFilter" Header="Série / regroupement" Width="260"
                          DisplayMemberPath="Label" SelectionChanged="OnGroupFilterChanged" />
            </StackPanel>
            <ListView x:Name="Items" SelectionMode="Single" SelectionChanged="OnItemSelected">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:InventoryItem">
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,8">
                            <TextBlock Text="{x:Bind InventoryNumber}" Width="80" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Name}" Width="400" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind StateLabel}" Width="90" Opacity="0.8" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="LoadMoreButton" Content="Charger la suite" Click="OnLoadMore" HorizontalAlignment="Left" />

            <TextBlock Text="Fiche de l'objet" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Name="SelectedItemName" Text="Sélectionnez un objet dans l'inventaire." TextWrapping="Wrap" />
            <TextBlock x:Name="SelectedItemDetails" Text="" TextWrapping="Wrap" Opacity="0.7" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="EditedItemName" Header="Nom" Width="360" />
                <Button x:Name="SaveItemNameButton" Content="Enregistrer le nom" Click="OnSaveItemName" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBox x:Name="EditedDescription" Header="Description" Width="700" Height="110"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="10000" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="EditedHistoricalReference" Header="Référence historique" Width="340" MaxLength="500" />
                <TextBox x:Name="EditedTechnicalReference" Header="Référence technique" Width="340" MaxLength="500" />
            </StackPanel>
            <Button x:Name="SaveItemDetailsButton" Content="Enregistrer la description et les références"
                    Click="OnSaveItemDetails" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ArchiveItemButton" Content="Archiver" Click="OnArchiveItem" />
                <Button x:Name="TrashItemButton" Content="Mettre à la corbeille" Click="OnTrashItem" />
                <Button x:Name="RestoreItemButton" Content="Restaurer" Click="OnRestoreItem" />
            </StackPanel>
            <TextBlock Text="Classement et champs de l'objet" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Name="AssignedCategories" Text="Aucune catégorie." TextWrapping="Wrap" />
            <TextBlock Text="Cochez les catégories à conserver ou à ajouter. Les valeurs des champs encore applicables sont préservées ; les autres restent seulement dans l'historique." TextWrapping="Wrap" />
            <ListView x:Name="ItemCategoryChoices" SelectionMode="Multiple" Height="130" DisplayMemberPath="Label" />
            <Button x:Name="SaveItemCategoriesButton" Content="Enregistrer le classement" Click="OnSaveItemCategories" HorizontalAlignment="Left" />
            <TextBlock Text="Séries et regroupements de l'objet" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ListView x:Name="ItemGroupChoices" SelectionMode="Multiple" Height="130" DisplayMemberPath="Label" />
            <Button x:Name="SaveItemGroupsButton" Content="Enregistrer les séries et regroupements"
                    Click="OnSaveItemGroups" HorizontalAlignment="Left" />
            <TextBlock Text="Relations avec d'autres objets" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="Un lien est déclaré par l'objet sélectionné vers un autre objet du même espace. Les liens entrants sont visibles mais se retirent depuis l'objet qui les déclare." TextWrapping="Wrap" />
            <ListView x:Name="ItemRelations" SelectionMode="Single" Height="130" SelectionChanged="OnRelationSelected">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ItemRelation">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,6">
                            <TextBlock Text="{x:Bind KindLabel}" Width="120" />
                            <TextBlock Text="{x:Bind DirectionLabel}" Width="80" Opacity="0.8" />
                            <TextBlock Text="{x:Bind RelatedItemName}" Width="380" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="RelationTargetChoices" Header="Objet lié" Width="300" DisplayMemberPath="Label" />
                <ComboBox x:Name="RelationKindChoices" Header="Type" Width="160" SelectedIndex="0">
                    <ComboBoxItem Content="Lié" Tag="related" />
                    <ComboBoxItem Content="Variante de" Tag="variant_of" />
                    <ComboBoxItem Content="Fait partie de" Tag="part_of" />
                </ComboBox>
                <Button x:Name="AddRelationButton" Content="Ajouter le lien" Click="OnAddRelation" VerticalAlignment="Bottom" />
                <Button x:Name="RemoveRelationButton" Content="Retirer le lien sortant" Click="OnRemoveRelation" VerticalAlignment="Bottom" />
                <Button x:Name="RefreshRelationsButton" Content="Actualiser" Click="OnRefreshRelations" VerticalAlignment="Bottom" />
            </StackPanel>
            <ListView x:Name="EffectiveFields" Height="140" DisplayMemberPath="Label" SelectionChanged="OnEffectiveFieldSelected" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="FieldValue" Header="Valeur du champ sélectionné" Width="350" />
                <Button x:Name="SaveFieldValueButton" Content="Enregistrer" Click="OnSaveFieldValue" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock Text="Emplacement courant et déplacements" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Name="CurrentLocationText" Text="Aucun emplacement." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ItemLocationChoices" Header="Déplacer vers" Width="400" DisplayMemberPath="Label" />
                <Button x:Name="MoveItemLocationButton" Content="Enregistrer l'emplacement" Click="OnMoveItemLocation" VerticalAlignment="Bottom" />
            </StackPanel>
            <ListView x:Name="LocationHistory" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ItemLocationEvent">
                        <StackPanel Margin="0,6,0,6" Spacing="4">
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Date}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Transfert et historique" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DestinationSpaces" Header="Espace de destination" Width="320" DisplayMemberPath="Name" SelectionChanged="OnDestinationSelected" />
                <Button x:Name="TransferButton" Content="Transférer l'objet" Click="OnTransferItem" VerticalAlignment="Bottom" />
                <Button x:Name="RefreshHistoryButton" Content="Actualiser l'historique" Click="OnRefreshHistory" VerticalAlignment="Bottom" />
            </StackPanel>
            <ListView x:Name="TransferHistory" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:TransferDisplay">
                        <StackPanel Margin="0,8,0,8" Spacing="4">
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Date}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="StateAuditPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Historique des états dans cet espace" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBlock Text="Visible par le propriétaire ou un administrateur. Les événements d'un ancien espace ne sont pas affichés ici." TextWrapping="Wrap" />
                <Button x:Name="RefreshStateAuditButton" Content="Actualiser l'audit" Click="OnRefreshStateAudit" HorizontalAlignment="Left" />
                <ListView x:Name="StateAuditHistory" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:ItemStateAuditEvent">
                            <StackPanel Margin="0,8,0,8" Spacing="4">
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Date}" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <TextBlock Text="Pour un objet déjà classé, choisissez au moins une catégorie de l'espace de destination avant le transfert." TextWrapping="Wrap" />
            <ListView x:Name="DestinationCategoryChoices" SelectionMode="Multiple" Height="130" DisplayMemberPath="Label" />
        </StackPanel>
    </ScrollViewer>
</Page>
