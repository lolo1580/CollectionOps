<Page
    x:Class="CollectionOps.Client.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Votre collection" />
            <TextBlock x:Name="SessionStatus" Style="{StaticResource BodyLargeTextBlockStyle}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Ouvrir l'inventaire" Click="OnOpenCollection" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Compte et connexion" Click="OnOpenAccount" />
            </StackPanel>
            <TextBlock Text="Comment commencer" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock Text="1. Choisissez ou créez un espace pour votre collection." TextWrapping="Wrap" />
            <TextBlock Text="2. Ajoutez un objet par son nom ; sa fiche s'ouvre ensuite dans l'inventaire." TextWrapping="Wrap" />
            <TextBlock Text="3. Complétez sa description, son classement et son emplacement à votre rythme." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

