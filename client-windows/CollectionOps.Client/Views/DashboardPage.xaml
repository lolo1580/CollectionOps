<Page
    x:Class="CollectionOps.Client.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="CollectionOps" />
            <TextBlock
                MaxWidth="720"
                HorizontalAlignment="Left"
                Style="{StaticResource BodyLargeTextBlockStyle}"
                Text="Le client Windows prend désormais en charge la connexion et la gestion des sessions. Les tableaux de bord métier seront construits à partir des exigences validées." />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="Ouvrez Compte pour connecter le client au serveur. Le stockage local hors ligne reste à concevoir."
                Severity="Informational"
                Title="Phase initiale" />
        </StackPanel>
    </ScrollViewer>
</Page>

